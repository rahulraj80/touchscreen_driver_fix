# Scoped capture access for the damaged FTSC1000 touch digitizer.
#
# Grants the active seat user read access to exactly two nodes of HID
# 0018:2808:5112 — the raw report stream (/dev/hidraw*) and the decoded event
# node (/dev/input/event*). Nothing else on the box changes: this is NOT
# `input` group membership and NOT a blanket udev permission widening.
#
# The touchpad (0018:04F3:301A) is a different device on the same i2c bus and
# is deliberately not matched here.
#
# Install: scripts/install-access.sh (root). Verify: scripts/doctor.sh.

# Raw HID reports — the ground truth for capture and replay.
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="2808", ATTRS{idProduct}=="5112", TAG+="uaccess"

# Decoded multi-touch events — what libinput/KWin actually consume.
SUBSYSTEM=="input", ATTRS{idVendor}=="2808", ATTRS{idProduct}=="5112", ENV{ID_INPUT_TOUCHSCREEN}=="1", TAG+="uaccess"
